// Shared build settings for the HapticEngine demo app.
// Personal signing lives in Signing.local.xcconfig (gitignored).

PRODUCT_BUNDLE_IDENTIFIER = dev.codepassion.HapticEngineDemo
PRODUCT_NAME = $(TARGET_NAME)
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1

IPHONEOS_DEPLOYMENT_TARGET = 18.0
TARGETED_DEVICE_FAMILY = 1,2
SWIFT_VERSION = 6.0

CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM =

#include? "Signing.local.xcconfig"
